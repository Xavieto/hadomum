        "config_entry_id": {
          "name": "Domum entry",
          "description": "Optional when a single entry is configured."
        },
        "child": {
          "name": "Child",
          "description": "Child's first name or identifier."
        },
        "minutes": {
          "name": "Minutes",
          "description": "Duration in minutes."
        }
      }
    },
    "punish": {
      "name": "Punish a child",
      "description": "Applies a punishment (duration and mode from the integration options by default).",
      "fields": {
        "config_entry_id": {
          "name": "Domum entry",
          "description": "Optional when a single entry is configured."
        },
        "child": {
          "name": "Child",
          "description": "Child's first name or identifier."
        },
        "minutes": {
          "name": "Minutes",
          "description": "Duration in minutes."
        },
        "mode": {
          "name": "Mode",
          "description": "Punishment profile or Internet cut."
        }
      }
    },
    "lift_punishment": {
      "name": "Lift a punishment",
      "description": "Lifts a child's current punishment.",
      "fields": {
        "config_entry_id": {
          "name": "Domum entry",
          "description": "Optional when a single entry is configured."
        },
        "child": {
          "name": "Child",
          "description": "Child's first name or identifier."
        }
      }
    },
    "family_event": {
      "name": "Family event",
      "description": "Triggers in Domum the action bound to an event (alarm in night mode...).",
      "fields": {
        "config_entry_id": {
          "name": "Domum entry",
          "description": "Optional when a single entry is configured."
        },
        "event": {
          "name": "Event",
          "description": "Event name defined in Domum."
        }
      }
    }
